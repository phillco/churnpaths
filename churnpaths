#!/usr/bin/env -S uv run --script
"""One list of high-churn, regenerable folders, applied to every backup and
indexing tool that would otherwise spend time and space on them.

Targets: spotlight (Search Privacy), timemachine (sticky exclusions), backblaze
(marked block in its editable exclusions XML). By default every target
available on this machine is used and the run is a preview; -a applies, -c
checks for drift (exit 1), `status` shows per-folder state, -l -j prints the
resolved folders as JSON.

The list is found, in order, from --source, $CHURNPATHS_SOURCE, `source` in
~/.config/churnpaths/config.toml ($CHURNPATHS_CONFIG overrides that file), then
~/.config/churnpaths/churn-paths.txt.
"""

from __future__ import annotations

import argparse
import fcntl
import glob
import json
import os
import shutil
import socket
import subprocess
import sys
import tempfile
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

import backblaze_xml  # noqa: E402
import tm_exclusion_api  # noqa: E402

CONFIG_DIR = Path.home() / ".config/churnpaths"


def load_config():
    """Optional TOML config: `source` (list file) and `state` (Spotlight state)."""
    path = Path(os.environ.get("CHURNPATHS_CONFIG") or CONFIG_DIR / "config.toml")
    if not path.is_file():
        return {}
    import tomllib

    try:
        config = tomllib.loads(path.read_text())
    except (OSError, tomllib.TOMLDecodeError) as error:
        raise ValueError(f"{path}: {error}") from error
    for key in ("source", "state"):
        if key in config and not isinstance(config[key], str):
            raise ValueError(f"{path}: {key} must be a string")
    return config


def default_source(config=None):
    config = load_config() if config is None else config
    raw = os.environ.get("CHURNPATHS_SOURCE") or config.get("source")
    return Path(raw).expanduser() if raw else CONFIG_DIR / "churn-paths.txt"


def default_state(config=None):
    config = load_config() if config is None else config
    raw = os.environ.get("CHURNPATHS_STATE") or config.get("state")
    if raw:
        return Path(raw).expanduser()
    return Path.home() / ".local/state/churnpaths/spotlight.json"


def normalized(raw, allow_symlink=False):
    if not isinstance(raw, str):
        raise ValueError("folder paths must be strings")
    path = Path(raw).expanduser()
    if not path.is_absolute() or ".." in path.parts:
        raise ValueError(f"expected an absolute path or ~/path: {raw}")
    path = Path(os.path.normpath(path))
    if path in {
        Path("/"),
        Path("/Users"),
        Path("/Volumes"),
        Path.home(),
        Path("/System/Volumes"),
        Path("/System/Volumes/Data"),
    }:
        raise ValueError(f"refusing broad folder exclusion: {raw}")
    if path.parent in {Path("/Users"), Path("/Volumes")}:
        raise ValueError(
            f"whole homes/volumes belong in mechanism-specific policy: {raw}"
        )
    if not allow_symlink and any(p.is_symlink() for p in (path, *path.parents)):
        raise ValueError(f"refusing symlink folder or ancestor: {raw}")
    if path.is_mount():
        raise ValueError(f"mounted roots belong in mechanism-specific policy: {raw}")
    return path


def resolve(source, hostname):
    """Bounded discovery; never follow symlink folders or recurse into matches."""
    rules, includes = [], []
    for lineno, raw in enumerate(source.read_text().splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("@"):
            selector, line = line.split(maxsplit=1)
            if selector[1:].casefold() not in {"*", hostname.casefold()}:
                continue
        directive, rest = line.split(maxsplit=1)
        if directive == "include":
            includes.append(rest)
            continue
        if directive not in {"path", "glob", "name"}:
            raise ValueError(f"{source}:{lineno}: unknown directive {directive}")
        rules.append((directive, rest))
    paths, missing, unmatched, names, skipped = set(), set(), [], [], []
    # Generated lists (written by another tool): exact `path` lines
    # only; a missing file is empty, and an invalid entry is skipped, not fatal.
    for raw in includes:
        listing = Path(raw).expanduser()
        if not listing.is_file():
            continue
        for line in listing.read_text().splitlines():
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            directive, _, rest = line.partition(" ")
            try:
                if directive != "path":
                    raise ValueError(f"only path lines are allowed in {listing}")
                path = normalized(rest.strip())
                if path.is_symlink() or (path.exists() and not path.is_dir()):
                    raise ValueError(f"not a plain folder: {path}")
            except ValueError:
                skipped.append(rest.strip() or line)
                continue
            if path.is_dir():
                paths.add(str(path))
    for directive, rest in rules:
        if directive == "name":
            name, root = rest.split(maxsplit=1)
            if "/" in name or name in {".", ".."}:
                raise ValueError(f"invalid folder name: {name}")
            names.append((name, normalized(root)))
            continue
        path = normalized(rest)
        if directive == "glob":
            if any(c in str(path.parent) for c in "*?[") or "**" in str(path):
                raise ValueError("globs must match one immediate child folder")
            hits = [Path(p) for p in sorted(glob.glob(str(path))) if Path(p).is_dir()]
            # A symlinked match (e.g. a worktree alias) is reported and skipped;
            # its target is excluded only through its own rule. Exact symlink
            # paths and symlinked glob parents still fail closed below.
            links = [str(p) for p in hits if p.is_symlink()]
            skipped += links
            hits = [p for p in hits if not p.is_symlink()]
            if not hits and not links:
                unmatched.append(str(path))
        else:
            hits = [path]
            if not path.exists():
                missing.add(str(path))
        for hit in hits:
            hit = normalized(str(hit))
            if hit.is_symlink():
                raise ValueError(f"refusing symlink folder: {hit}")
            if hit.is_dir():
                paths.add(str(hit))
            elif hit.exists():
                raise ValueError(f"not a directory: {hit}")
    by_root = {}
    for name, root in names:
        by_root.setdefault(root, set()).add(name)
    deadline, visited = time.monotonic() + 30, 0

    def walk_error(error):
        raise error

    for root, wanted in by_root.items():
        if not root.exists():
            continue
        root_device = root.stat().st_dev
        for parent, dirs, _ in os.walk(root, followlinks=False, onerror=walk_error):
            visited += 1
            if visited > 100000 or time.monotonic() > deadline:
                raise ValueError(
                    f"dependency discovery exceeded limit under {root} at {parent}; narrow name roots"
                )
            if parent in paths:
                dirs[:] = []
                continue
            # Source roots can contain enormous monorepos. Named rules cover
            # the first four levels, never an unbounded disk-wide traversal.
            if len(Path(parent).relative_to(root).parts) >= 4:
                dirs[:] = []
                continue
            keep = []
            for name in dirs:
                child = Path(parent) / name
                if child.is_symlink() or name in {".git", ".jj"}:
                    continue
                if child.stat().st_dev != root_device:
                    continue
                if (
                    name in wanted
                    and (
                        name not in {"venv", ".venv"}
                        or (child / "pyvenv.cfg").is_file()
                        or (child / "bin/activate").is_file()
                    )
                    and (
                        name != "target"
                        or (child / ".rustc_info.json").is_file()
                        or (child / "debug/deps").is_dir()
                        or (child / "release/deps").is_dir()
                    )
                ):
                    paths.add(str(child))
                else:
                    keep.append(name)
            dirs[:] = keep
    minimal = []
    for path in sorted(paths, key=lambda p: (len(Path(p).parts), p)):
        if not any(Path(parent) in Path(path).parents for parent in minimal):
            minimal.append(path)
    return {
        "paths": sorted(minimal),
        "missing": sorted(missing),
        "unmatched": unmatched,
        "skipped": sorted(set(skipped)),
    }


def write_json(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, delete=False) as tmp:
        json.dump(value, tmp, indent=2)
        tmp.write("\n")
    os.replace(tmp.name, path)


def reconcile(args, result):
    import churnpaths_spotlight as spotlight

    state_path = args.state.expanduser()
    state_path.parent.mkdir(parents=True, exist_ok=True)
    with (state_path.parent / "spotlight.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        state = {"version": 1, "managed": []}
        if state_path.exists():
            state = json.loads(state_path.read_text())
            if (
                not isinstance(state, dict)
                or state.get("version") != 1
                or not isinstance(state.get("managed"), list)
            ):
                raise ValueError("invalid Spotlight ownership state")
        # An owned folder later replaced by a symlink stays owned, so its stale
        # Spotlight entry is removed rather than aborting the reconcile.
        owned = {str(normalized(p, allow_symlink=True)) for p in state["managed"]}
        desired = set(result["paths"])
        # Missing folders still registered with Spotlight retain their ownership.
        declared = desired | set(result["missing"])
        current = set(spotlight.exclusions())
        owned &= current
        add, remove = sorted(desired - current), sorted((owned - declared) & current)
        result.update(add=add, remove=remove, current=sorted(current))
        if args.apply:
            if (
                args.hostname.casefold()
                != socket.gethostname().split(".", 1)[0].casefold()
            ):
                raise ValueError("--apply hostname must match this machine")
            write_json(state_path, {"version": 1, "managed": sorted(owned)})
            for excluded, targets in [(True, add), (False, remove)]:
                for path in targets:
                    event = {"time": time.time(), "path": path, "excluded": excluded}
                    # Write the intent and ownership before calling the API, so a
                    # process crash cannot leave an untracked privacy exclusion.
                    event["before"] = sorted(spotlight.exclusions())
                    with (state_path.parent / "changes.ndjson").open("a") as log:
                        log.write(json.dumps(event) + "\n")
                    if excluded:
                        owned.add(path)
                    write_json(state_path, {"version": 1, "managed": sorted(owned)})
                    spotlight.set_excluded(path, excluded)
                    if not excluded:
                        owned.discard(path)
                    write_json(state_path, {"version": 1, "managed": sorted(owned)})
            after = set(spotlight.exclusions())
            if not desired <= after or (set(remove) & after):
                raise RuntimeError(
                    "Spotlight privacy read-back differs from requested changes"
                )
            result["applied"] = True
        return bool(add or remove)



TARGETS = ("spotlight", "timemachine", "backblaze")
NOTES = {
    "timemachine": (
        "Time Machine exclusions are sticky: removing a list entry never "
        "re-includes a folder; undo with `tmutil removeexclusion PATH`"
    ),
    "backblaze": "dry run is the default; nothing is written to Backblaze without -a",
}


def local_host():
    return socket.gethostname().split(".", 1)[0]


def availability(target, args):
    """Return None when the target can run here, else a short reason."""
    if sys.platform != "darwin":
        return "macOS only"
    if target == "timemachine" and not shutil.which("tmutil"):
        return "tmutil not found"
    if target == "backblaze" and not args.xml.exists():
        return f"Backblaze not installed ({args.xml} not found)"
    return None


def plan_spotlight(args, result, apply):
    # reconcile annotates its result, so give it a private copy.
    scratch = dict(result)
    args.apply = apply
    drift = reconcile(args, scratch)
    return {
        "add": scratch["add"],
        "remove": scratch["remove"],
        "in_sync": not drift,
        "applied": bool(scratch.get("applied")),
        "detail": f"{len(scratch['current'])} in Search Privacy",
    }


def plan_timemachine(args, result, apply):
    targets = sorted(Path(p) for p in result["paths"])
    states = tm_exclusion_api.exclusion_states(targets)
    pending = [p for p in targets if not states[p]]
    added, failures = [], 0
    if apply:
        for batch in tm_exclusion_api.batches(pending):
            for path in batch:
                try:
                    tm_exclusion_api.set_excluded(path)
                except (OSError, RuntimeError, ValueError) as error:
                    failures += 1
                    print(f"failed: {path}: {error}", file=sys.stderr, flush=True)
            # The setter can silently ignore unsupported properties, so read back.
            after = tm_exclusion_api.exclusion_states(batch)
            added.extend(p for p in batch if after[p])
            for p in (p for p in batch if not after[p]):
                failures += 1
                print(f"failed: {p}: still included after write", file=sys.stderr)
    else:
        added = pending
    return {
        "add": [str(p) for p in added],
        "remove": [],
        "in_sync": not pending if not apply else not failures,
        "applied": apply and not failures,
        "failed": failures,
        "detail": (
            f"already excluded {len(targets) - len(pending)}, "
            f"missing {len(result['missing'])}"
        ),
    }


def backblaze_policy(args):
    return backblaze_xml.XMLPolicy(args.xml, args.state_dir)


def plan_backblaze(args, result, apply):
    # Missing exact folders stay deferred, so a deleted-then-recreated folder
    # is never briefly uploaded.
    desired = set(result["paths"]) | set(result["missing"])
    policy = backblaze_policy(args)
    owned = policy.owned()
    add, remove = sorted(desired - owned), sorted(owned - desired)
    applied = False
    if apply and (add or remove):
        policy.set_many(add, True)
        policy.set_many(remove, False)
        if policy.owned() != desired:
            raise backblaze_xml.XMLPolicyError("readback differs from requested rules")
        applied = True
    return {
        "add": add,
        "remove": remove,
        "in_sync": applied or not (add or remove),
        "applied": applied,
        "detail": f"{len(desired)} desired, {len(owned)} owned before",
    }


PLANNERS = {
    "spotlight": plan_spotlight,
    "timemachine": plan_timemachine,
    "backblaze": plan_backblaze,
}


def folder_states(target, args, result):
    """Per-folder (path, excluded, exists) for the status subcommand."""
    present = [Path(p) for p in result["paths"]]
    missing = [Path(p) for p in result["missing"]]
    if target == "spotlight":
        import churnpaths_spotlight as spotlight

        excluded = set(spotlight.exclusions())
        flag = lambda p: str(p) in excluded  # noqa: E731
    elif target == "timemachine":
        states = tm_exclusion_api.exclusion_states(present)
        flag = lambda p: states.get(p, False)  # noqa: E731
    else:
        owned = backblaze_policy(args).owned()
        flag = lambda p: str(p) in owned  # noqa: E731
    rows = [(str(p), flag(p), True) for p in present]
    rows += [(str(p), flag(p), False) for p in missing]
    return rows


def print_plan(name, plan, mode):
    label = {"apply": "applied", "check": "check", "dry": "dry run"}[mode]
    done = mode == "apply"
    if name == "timemachine":
        summary = f"{'excluded' if done else 'would exclude'} {len(plan['add'])}"
    else:
        summary = (
            f"{'added' if done else 'add'} {len(plan['add'])}, "
            f"{'removed' if done else 'remove'} {len(plan['remove'])}"
        )
    print(f"{name} [{label}]: {summary}, {plan['detail']}", flush=True)
    for path in plan["add"]:
        print(f"  + {path}", flush=True)
    for path in plan["remove"]:
        print(f"  - {path}", flush=True)
    if name == "timemachine" or (name == "backblaze" and mode == "dry"):
        print(f"  note: {NOTES[name]}", flush=True)


def select_targets(args):
    """Return ([(target, reason-or-None)], explicit)."""
    requested = args.target or []
    # -m is the old name for -t; it only ever selected a single consumer.
    if args.mechanism:
        requested = [*requested, args.mechanism]
    explicit = bool(requested) and "all" not in requested
    names = list(TARGETS) if not requested or "all" in requested else requested
    names = [t for t in TARGETS if t in names]
    return [(t, availability(t, args)) for t in names], explicit


def build_parser(config):
    parser = argparse.ArgumentParser(
        prog="churnpaths",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "command",
        nargs="?",
        choices=["status"],
        help="status: show each folder's state per target",
    )
    parser.add_argument(
        "-s",
        "--source",
        type=Path,
        default=default_source(config),
        help="churn list file (default: %(default)s)",
    )
    parser.add_argument(
        "-H",
        "--hostname",
        default=local_host(),
        help="host selector for @host lines (default: this host)",
    )
    parser.add_argument(
        "-t",
        "--target",
        action="append",
        choices=[*TARGETS, "all"],
        help="spotlight, timemachine, backblaze or all; repeatable "
        "(default: every target available on this machine)",
    )
    parser.add_argument("-m", "--mechanism", choices=TARGETS, help=argparse.SUPPRESS)
    parser.add_argument("-j", "--json", action="store_true", help="JSON output")
    parser.add_argument(
        "-l",
        "--list",
        action="store_true",
        help="resolve folders only; touch no target",
    )
    parser.add_argument(
        "-x",
        "--xml",
        type=Path,
        default=backblaze_xml.DEFAULT_CONFIG,
        help="Backblaze editable exclusions file (default: %(default)s)",
    )
    parser.add_argument(
        "--state-dir",
        type=Path,
        help="Backblaze backups and change log (default: churnpaths state)",
    )
    parser.add_argument(
        "--state",
        type=Path,
        default=default_state(config),
        help="private Spotlight ownership state (default: %(default)s)",
    )
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument(
        "-a", "--apply", action="store_true", help="write changes (default: preview)"
    )
    mode.add_argument(
        "-c", "--check", action="store_true", help="exit 1 when any target has drift"
    )
    mode.add_argument(
        "-n", "--dry-run", action="store_true", help="preview only (the default)"
    )
    return parser


def run_status(args, result, targets):
    report, code = {}, 0
    for name, reason in targets:
        if reason:
            report[name] = {"unavailable": reason}
            if not args.json:
                print(f"{name}: skipped ({reason})", flush=True)
            continue
        try:
            rows = folder_states(name, args, result)
        except (OSError, ValueError, RuntimeError, subprocess.TimeoutExpired) as e:
            print(f"churnpaths: {name}: {e}", file=sys.stderr, flush=True)
            code = 2
            continue
        report[name] = {
            path: ("excluded" if on else "included") + ("" if exists else ", missing")
            for path, on, exists in rows
        }
        if not args.json:
            print(f"{name}:", flush=True)
            for path, on, exists in rows:
                mark = ("+" if on else "-") if exists else "?"
                print(f"  {mark} {path}{'' if exists else ' (missing)'}", flush=True)
    if args.json:
        print(json.dumps({"targets": report}, indent=2), flush=True)
    return code


def main(argv=None):
    try:
        config = load_config()
    except ValueError as error:
        print(f"churnpaths: {error}", file=sys.stderr)
        return 2
    parser = build_parser(config)
    args = parser.parse_args(argv)
    if args.command == "status" and (args.apply or args.check or args.dry_run):
        parser.error("status takes no -a/-c/-n")
    if args.list and (args.apply or args.check or args.command):
        parser.error("-l only resolves; it cannot be combined with -a, -c or status")
    try:
        result = resolve(args.source.expanduser(), args.hostname)
        if args.list:
            if args.json:
                print(json.dumps(result, indent=2), flush=True)
            else:
                for key in ["paths", "missing", "unmatched", "skipped"]:
                    for path in result[key]:
                        print(f"{key}: {path}", flush=True)
            return 0
        targets, explicit = select_targets(args)
        if explicit:
            # An explicitly requested target that cannot run is an error.
            for name, reason in targets:
                if reason:
                    raise ValueError(f"{name} is unavailable: {reason}")
        if args.apply and args.hostname.casefold() != local_host().casefold():
            raise ValueError("--apply hostname must match this machine")
        if args.command == "status":
            return run_status(args, result, targets)
        mode = "apply" if args.apply else "check" if args.check else "dry"
        code, drift, report = 0, False, {}
        for name, reason in targets:
            if reason:
                report[name] = {"unavailable": reason}
                if not args.json:
                    print(f"{name}: skipped ({reason})", flush=True)
                continue
            try:
                plan = PLANNERS[name](args, result, args.apply)
            except (
                OSError,
                ValueError,
                RuntimeError,
                subprocess.TimeoutExpired,
            ) as error:
                print(f"churnpaths: {name}: {error}", file=sys.stderr, flush=True)
                report[name] = {"error": str(error)}
                code = 2
                continue
            report[name] = plan
            if plan.get("failed"):
                code = 2
            drift = drift or not plan["in_sync"]
            if not args.json:
                print_plan(name, plan, mode)
        if args.json:
            print(json.dumps({**result, "targets": report}, indent=2), flush=True)
        elif not any(not r for _, r in targets):
            print("churnpaths: no target available on this machine", file=sys.stderr)
        return code or (1 if args.check and drift else 0)
    except (OSError, ValueError, RuntimeError) as error:
        print(f"churnpaths: {error}", file=sys.stderr, flush=True)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
